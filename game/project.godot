; Engine configuration file.
;
; Authority: docs/technical/00-technical-foundation.md
;              § Accepted stack (Godot 4.7.1 .NET, C# only, Mobile renderer)
;              § Renderer baseline
;            docs/technical/100-build-dependencies-and-release-operations.md
;              § Godot import and export (this file is committed; .godot and
;              export_credentials.cfg are not)
; Requirements: TR-FND-001, TR-FND-002, TR-BLD-001, TR-BLD-006
; Verification: VER-FND-001-012 (headless import), VER-FND-001-013 (headless launch)
;
; Owned by the FND-001 integration owner. Window/viewport sizes for the 1920x1080
; and 1280x800 reference layouts belong to PRE-002 and UI-003; input actions
; belong to UI-002; export presets belong to FND-006. FND-001 sets only what the
; pinned engine, the C# assembly, and the Mobile renderer require.

config_version=5

[application]

config/name="Mecha Miner Survivor"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")

[dotnet]

project/assembly_name="MechaMiner.Game"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"

[input]

; Active-play move vector (UI-002). docs/technical/60-ui-input-and-accessibility.md
; § Logical input actions makes "move vector" the first active-play logical action and
; requires gameplay to "consume logical actions rather than physical key/button checks".
;
; Four one-directional actions rather than one two-dimensional one, because the engine's
; action system is one-dimensional; Input.GetVector composes them into the logical vector
; that MovementInputAdapter returns. The names are simulation-relative, not screen-relative:
; TDR-005 § Coordinate contract has X increase east and Y increase north, and north is
; screen-up on the fixed north-up camera, so east/north/west/south read the same on the
; plane and on screen.
;
; Bindings are by PHYSICAL keycode, which is layout-independent: the same three keys sit in
; the same places on an AZERTY keyboard, where a keycode binding would put "move_west" on Q.
; Arrow keys are bound as well as WASD because the arrows are what a person tries first when
; a build does not say which keys it uses. The joypad left stick is axis 0 for east/west and
; axis 1 for north/south, where axis 1 is positive DOWNWARD - hence -1.0 for north.
;
; deadzone is 0 on every action deliberately. doc 60 § Movement:65 specifies ONE radial
; deadzone of 0.18, applied to the composed vector; a per-action deadzone here would compose
; with it into a square deadzone that neither that number nor the engine default describes.
; MovementInputAdapter owns the radial rule and passes 0 to Input.GetVector for the same
; reason.
;
; Remapping, alternate bindings, and the configurable deadzone are UI-009's settings work.
;
; The encoding matters and is easy to get wrong. project.godot serializes an event as
; Object(ClassName,"prop":value,...); the JSON {"type": "InputEventKey", ...} form belongs to
; .tscn files. An earlier revision of this file used the .tscn form, and the result was silent:
; every action was created and InputMap.HasAction returned true for all four, but each one had
; an EMPTY event list, so no key was bound to anything and the mech could not be moved by a
; player. game/tests/RunSliceCaptureHarness.cs logs InputMap.ActionGetEvents counts and
; InputMap.EventIsAction per binding for exactly that reason.

move_east={
"deadzone": 0.0,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194321,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":0,"axis_value":1.0,"script":null)
]
}

