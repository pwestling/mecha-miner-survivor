<Project>

  <!--
    The version-controlled build-identity pins (FND-004). Imported first so every
    project can read the product version, and so MechaMiner.Diagnostics can bake
    the whole set into assembly metadata. See build/version-identity.props.
  -->
  <Import Project="$(MSBuildThisFileDirectory)build/version-identity.props" />

  <!--
    Repository-wide pins for every C# project in MechaMiner.sln.

    Authority: docs/technical/100-build-dependencies-and-release-operations.md
               (Toolchain pinning, C# project standards)
               docs/technical/00-technical-foundation.md (Version policy)
    Requirements: TR-BLD-001, TR-BLD-006, TR-FND-001

    Owned by the FND-001 integration owner. Consumer work packages must not edit
    this file; request the change instead (docs/technical/delivery-waves.md).
  -->

  <PropertyGroup Label="Pinned target framework and language">
    <!--
      net8.0 is the .NET baseline of the pinned Godot 4.7.1 .NET distribution:
      GodotSharp 4.7.1 declares net8.0 and ships only lib/net8.0. Godot's
      GodotPlugins runtimeconfig rolls forward to the installed .NET 10 runtime.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <!--
      Pinned, never "preview" or "latest". 12.0 is the C# version that matches
      the pinned net8.0 target framework, so no language feature can depend on a
      BCL surface the pinned target does not have.
    -->
    <LangVersion>12.0</LangVersion>
    <!--
      Only the .NET 10 runtime is installed alongside SDK 10.0.302, so net8.0
      apps and test hosts must roll forward to it.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!--
    Build configurations (doc 100 § Build configurations).

    Doc 100 names three configurations: Debug, Development, Release. Godot.NET.Sdk
    declares its own three in its Sdk.props - Debug;ExportDebug;ExportRelease - and
    Godot's tooling only ever asks for those names: the editor builds Debug, and an
    export preset's "export with debug" flag selects ExportDebug or ExportRelease.
    A fourth MSBuild configuration named Development would therefore be one that no
    Godot export could ever produce.

    Resolution: doc 100's three configurations map 1:1 onto Godot's three MSBuild
    configuration identities. Nothing is dropped and nothing is invented.

      doc 100 name  MSBuild/Godot identity  optimization  intended use
      Debug         Debug                   off           local correctness development
      Development   ExportDebug             on            internal demo, balance, performance
      Release       ExportRelease           on            external shipping candidate

    The workflow vocabulary stays doc 100's: the configuration argument of
    ./build.sh build takes "development" and the wrapper translates it (see
    src/MechaMiner.Tools/Cli/WorkflowConfiguration.cs). Doc 100 § Build
    configurations was corrected in the same task to state both columns, as doc 114
    § Specification maintenance autonomy requires when "the documented contract
    cannot be implemented as written".

    Every project declares the same three so that a ProjectReference built from
    MechaMiner.Game under ExportRelease does not hand a pure library a configuration
    it does not know. Microsoft.NET.Sdk only understands Debug and Release, so
    Optimize and the diagnostic symbol are set explicitly below rather than
    inherited.
  -->
  <PropertyGroup Label="Configuration set">
    <Configurations>Debug;ExportDebug;ExportRelease</Configurations>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' " Label="doc 100 configuration: Debug">
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);MECHAMINER_DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'ExportDebug' " Label="doc 100 configuration: Development">
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);MECHAMINER_DEVELOPMENT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'ExportRelease' " Label="doc 100 configuration: Release">
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);MECHAMINER_RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Label="Symbols">
    <!--
      Portable symbols in a separate file for every configuration, including
      Release: doc 100 § Artifacts requires "symbols/debug mapping in a restricted
      separate artifact", which needs the pdb to exist and to be separable.
    -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Label="Locked dependency restore">
    <!-- Lock files are committed so CI can restore in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Label="Product version (FND-004)">
    <!--
      The semantic product version reaches every assembly, so an artifact listing
      and a crash header agree without a second source. The source commit and dirty
      flag are baked into MechaMiner.Diagnostics only, because resolving them costs
      a git invocation and one owner is enough: every consumer reads build identity
      from that one assembly (doc 115 § Mutable-state ownership matrix).
    -->
    <Version>$(MechaMinerProductVersion)</Version>
    <AssemblyVersion>$(MechaMinerProductVersion).0</AssemblyVersion>
    <FileVersion>$(MechaMinerProductVersion).0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Label="Repository conventions">
    <!-- Nothing in this repository is published as a NuGet package. -->
    <IsPackable>false</IsPackable>
    <!-- Namespaces are always explicit; see docs/technical/114 C# defaults. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!--
    C# project standards (doc 100 § C# project standards). Each of these is
    proved by a deliberately invalid fixture under build/policy-fixtures/,
    executed by build/verify-policies.sh.
  -->

  <PropertyGroup Label="Nullable reference checking (VER-FND-001-006)">
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Analyzers (VER-FND-001-007, VER-FND-001-008)">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Pinned to the pinned target framework, not floating with the SDK. -->
    <AnalysisLevel>8.0</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <!-- Makes the .editorconfig naming policy a build diagnostic, not editor-only. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Label="Deterministic build (VER-FND-001-011)">
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="Unsafe code disabled by default (VER-FND-001-010)">
    <!--
      doc 100: "Unsafe code disabled by default; a measured hot-path exception
      requires isolated ownership, tests, and a TDR if it becomes architectural."
    -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
