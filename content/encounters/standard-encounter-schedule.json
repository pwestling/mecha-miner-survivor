  "spawnFormations": [
    {
      "formation": "Stream",
      "definition": "repeated narrow batches enter from one off-screen sector along parallel paths."
    },
    {
      "formation": "Wall",
      "definition": "a broad line advances from one side with at least one clearly readable traversal gap."
    },
    {
      "formation": "Swarm",
      "definition": "a dense but bounded cluster enters from one quadrant."
    },
    {
      "formation": "Twin flanks",
      "definition": "matched streams enter from two separated sectors, leaving two other escape directions."
    },
    {
      "formation": "Encirclement",
      "definition": "a loose off-screen ring converges while preserving a visible 70–90-degree escape arc."
    },
    {
      "formation": "Convergence",
      "definition": "four smaller groups enter from cardinal sectors with diagonal gaps."
    },
    {
      "formation": "Rolling ring",
      "definition": "two separated incomplete encirclements arrive sequentially rather than spawning simultaneously."
    }
  ],
  "formationConstraints": [
