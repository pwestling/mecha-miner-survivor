<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore sources are declared in the repository so a clean checkout never
  depends on a developer's or runner's machine-level NuGet configuration.

  Authority: docs/technical/100-build-dependencies-and-release-operations.md
             (Continuous integration: "CI jobs start from clean checkouts and
             cannot depend on ... global NuGet cache contents")
  Requirements: TR-BLD-002
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
