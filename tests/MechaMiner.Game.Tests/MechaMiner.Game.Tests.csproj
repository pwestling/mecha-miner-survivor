<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine integration, scene, rendering, input, and export smoke tests
    (docs/technical/10 § Accepted project decomposition).

    doc 10 records this project's Godot dependency as "Yes". That engine
    dependency is deliberately NOT taken at FND-001: the shape of the harness -
    whether it references MechaMiner.Game directly, hosts GodotSharp itself, or
    drives a runner scene inside game/ through the pinned Godot executable - is
    the observable outcome owned by TASK-FND-003-002. Adding a guessed engine
    reference now would commit that contract before its task is Ready.

    Until then this project mirrors MechaMiner.Game's pure surface only, so the
    architecture check has exactly one Godot-referencing project (game/).
  -->

  <ItemGroup>
    <ProjectReference Include="../../src/MechaMiner.Content/MechaMiner.Content.csproj" />
    <ProjectReference Include="../../src/MechaMiner.Simulation/MechaMiner.Simulation.csproj" />
    <ProjectReference Include="../../src/MechaMiner.Persistence/MechaMiner.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
  </ItemGroup>

</Project>
