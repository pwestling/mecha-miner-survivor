<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Owns command-line workflows, audits, generators, reports, and benchmark
    orchestration.

    Accepted project boundary (docs/technical/115 § Accepted project boundary):
      allowed project dependencies: all pure projects
      Godot types allowed:          No; it may launch the pinned Godot
                                    executable as an external process

    TASK-FND-002-001 turns this library into the process entry point behind
    ./build.sh and ./build.ps1. The verb table, exit classes, and structured
    result artifacts live here so that no workflow logic is duplicated between
    shell languages (doc 100 § Standard command surface).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>MechaMiner.Tools</AssemblyName>
    <RootNamespace>MechaMiner.Tools</RootNamespace>
    <!--
      The wrapper invokes the assembly through `dotnet <dll>`, so the native
      apphost is dead weight in every build and in every artifact listing.
    -->
    <UseAppHost>false</UseAppHost>
    <!--
      Doc 40 § JSON codec and schema baseline mandates source-generated
      System.Text.Json metadata and forbids runtime contract reflection. The
      generator needs this switch to refuse to fall back to reflection.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MechaMiner.Content/MechaMiner.Content.csproj" />
    <!--
      CMP-OBS-001. The tool reads build identity, emits the SCH-BLD-001 manifest, and
      renders SCH-OBS-002 reports from the one diagnostics owner rather than deriving
      any of them a second time (FND-004, FND-007, FND-008).
    -->
    <ProjectReference Include="../MechaMiner.Diagnostics/MechaMiner.Diagnostics.csproj" />
    <ProjectReference Include="../MechaMiner.Simulation/MechaMiner.Simulation.csproj" />
    <ProjectReference Include="../MechaMiner.Persistence/MechaMiner.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup Label="Tests of the audits and validators this project owns">
    <InternalsVisibleTo Include="MechaMiner.Tools.Tests" />
  </ItemGroup>

</Project>
