<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure unit, property, fixture, and integration tests for MechaMiner.Simulation.
    Never launches Godot (docs/technical/91 § Test project separation).

    Shared deterministic fixture utilities and the first sample tests are owned
    by TASK-FND-003-001; this file only establishes the project and its pinned
    harness.
  -->

  <!--
    Reflection-based System.Text.Json is off in this test host, matching the
    constraint the shipping hosts run under.

    This is a runtimeconfig.json feature switch, so it is only honoured by the
    project that produces the entry-point runtimeconfig.json - the HOST. It does
    NOT propagate from a referenced library: a plain library emits no
    runtimeconfig.json at all, so setting the property beside the code it
    constrains changes nothing (measured, not assumed). It therefore has to be
    repeated in every test host.

    Without this, a reflection-based JsonSerializer call in a src/ library passes
    under `dotnet test` and throws only in the real host - the exact defect class
    the suite exists to catch.

    Do not move this property onto a library: a plain library emits no
    runtimeconfig.json, so the switch goes silently dead in every host
    (measured). A shared props file that each host imports - such as the root
    Directory.Build.props - does bind and is allowed. Either way this host owes a
    runtime assertion that the switch is live - full rule in
    tests/MechaMiner.Content.Tests/MechaMiner.Content.Tests.csproj.
  -->
  <PropertyGroup>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MechaMiner.Simulation/MechaMiner.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
  </ItemGroup>

  <ItemGroup Label="Shared deterministic fixture utilities (TASK-FND-003-001)">
    <!--
      Linked, not referenced. doc 100 § Repository structure prescribes a fixed,
      enumerated set of test projects and no shared test library, so the utilities are
      compiled into each test assembly and stay internal. The count is deliberately not
      restated here: doc 100's list grew from four to six when MechaMiner.Diagnostics.Tests
      and MechaMiner.Tools.Tests landed, and a number copied into six files is a claim that
      goes stale silently. build/verify-architecture.sh § 2 and
      AcceptedArchitecture.RequiredPaths hold the enumerated set instead, and both fail on a
      project the accepted decomposition does not name. See tests/shared/README.md.
    -->
    <Compile Include="../shared/**/*.cs" LinkBase="Support/Shared" />
  </ItemGroup>

</Project>
