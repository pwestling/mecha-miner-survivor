<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure unit, property, fixture, and golden tests for MechaMiner.Diagnostics
    (CMP-OBS-001): build identity, structured logging, redaction, rotation, the
    metric registry, and the benchmark report format.

    Never launches Godot (docs/technical/91 § Test project separation). The
    build-identity equality fixture that does need the engine lives in
    tests/MechaMiner.Game.Tests, because that is the project that owns the engine
    tier and its bounded process timeout.
  -->

  <ItemGroup>
    <ProjectReference Include="../../src/MechaMiner.Diagnostics/MechaMiner.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
  </ItemGroup>

  <ItemGroup Label="Shared deterministic fixture utilities (TASK-FND-003-001)">
    <!--
      Linked, not referenced, exactly as the other test projects do it: there is no
      shared test library, so the utilities are compiled into each test assembly and
      stay internal. See tests/shared/README.md.
    -->
    <Compile Include="../shared/**/*.cs" LinkBase="Support/Shared" />
  </ItemGroup>

</Project>
