# Python helper tooling
__pycache__/
*.py[cod]
.DS_Store

# Local build output. docs/technical/100 § Repository structure: "artifacts/
# ignored local outputs".
artifacts/
bin/
obj/

# Godot's local import/build cache. project.godot, *.import / *.uid import
# sidecars, and export_presets.cfg are deliberately NOT ignored - doc 100
# § Godot import and export requires them to be committed.
.godot/

# Godot documents export credentials as confidential (doc 100 § Godot import
# and export, § Secrets and signing).
export_credentials.cfg

# Per-developer IDE and user state
*.user

# The generated SCH-BLD-001 build manifest is a build output, not a committed
# source file. It records the source commit of the build that produced it, so a
# committed copy could never be current at the commit that contained it: the file
# cannot name its own commit. `./build.sh build` regenerates it and reads it back
# (VER-FND-004-005). Everything else under generated/ is committed reproducible
# output per doc 100 § Repository structure.
generated/build-manifest.json
