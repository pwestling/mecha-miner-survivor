[gd_scene load_steps=10 format=3]

; The gameplay run scene (PRE-001, PRE-002, UI-002). Launch it with:
;
;     godot --path game res://scenes/Run.tscn
;
; project.godot's main_scene stays res://scenes/Boot.tscn on purpose: VER-FND-001-013
; asserts that a headless launch of the MAIN scene prints BootCompositionRoot's exact
; startup line and produces no ERROR or WARNING line. Repointing main_scene here would
; change what that verification measures, and FND-001 owns it. FND-006's `run` verb is
; where launching this scene becomes the normal path.
;
; GRAYBOX. Everything visible below is scaffolding:
;   - ArenaGround is the 40 m square of GrayboxArenaBounds.Default, which MAP-007 replaces
;     with a validated geometry manifest. It is not a map.
;   - ReferenceMarkers are PRESENTATION ONLY and are not authoritative. Nothing in the
;     simulation knows they exist, they have no collision, and no gameplay rule reads them.
;     They exist because the camera follows the mech: over a featureless ground a moving
;     mech renders as a stationary mech, and there would be no way to see that movement
;     works. AST-006 replaces them along with the rest of the representative asset set.
;   - The chassis and nose are two boxes. The nose is modelled along +X so that a facing of
;     zero radians points east, which is what RunSceneRoot.ApplyGroundTransform assumes and
;     what docs/30:70 makes the initial facing.
;
; Both meshes hang off the PlayerBody pivot with their own upward offset, so the model's
; resting elevation is never part of the authoritative ground-plane centre
; (TDR-005 § Coordinate contract).

[ext_resource type="Script" path="res://presentation/RunSceneRoot.cs" id="1_run"]

[sub_resource type="StandardMaterial3D" id="mat_ground"]
albedo_color = Color(0.16, 0.17, 0.21, 1)
roughness = 0.9

[sub_resource type="PlaneMesh" id="mesh_ground"]
material = SubResource("mat_ground")
size = Vector2(40, 40)

[sub_resource type="StandardMaterial3D" id="mat_marker"]
albedo_color = Color(0.28, 0.30, 0.36, 1)
roughness = 0.9

[sub_resource type="BoxMesh" id="mesh_marker"]
material = SubResource("mat_marker")
size = Vector3(0.35, 0.12, 0.35)

[sub_resource type="StandardMaterial3D" id="mat_chassis"]
albedo_color = Color(0.85, 0.62, 0.16, 1)
roughness = 0.55

[sub_resource type="BoxMesh" id="mesh_chassis"]
material = SubResource("mat_chassis")
size = Vector3(0.8, 0.55, 0.8)

[sub_resource type="StandardMaterial3D" id="mat_nose"]
albedo_color = Color(0.95, 0.95, 0.92, 1)
roughness = 0.4

[sub_resource type="BoxMesh" id="mesh_nose"]
material = SubResource("mat_nose")
size = Vector3(0.45, 0.22, 0.22)

[sub_resource type="Environment" id="env_run"]
background_mode = 1
background_color = Color(0.06, 0.07, 0.09, 1)
ambient_light_source = 2
ambient_light_color = Color(0.55, 0.58, 0.66, 1)
ambient_light_energy = 0.7
tonemap_mode = 2

[node name="Run" type="Node3D"]
script = ExtResource("1_run")

[node name="RunEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("env_run")

; Rotation is set again in RunSceneRoot.ConfigureCamera, which is what makes the
; orthographic projection, the 24 m vertical extent, and the north-up orientation a
; contract rather than an inspector value. A quarter turn about X looks straight down and
; puts world -Z - simulation north - at screen up.
[node name="GameplayCamera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, -4.37114e-08, 1, 0, -1, -4.37114e-08, 0, 40, 0)
projection = 1
keep_aspect = 1
size = 24.0
near = 0.05
far = 80.0

[node name="SunLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.86, -0.35, 0.37, 0, 0.73, 0.68, -0.51, -0.59, 0.63, 0, 12, 0)
light_energy = 1.1
shadow_enabled = true

[node name="ArenaGround" type="MeshInstance3D" parent="."]
mesh = SubResource("mesh_ground")

