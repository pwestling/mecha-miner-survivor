<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure serialization, migration, atomicity, recovery, and settlement tests for
    MechaMiner.Persistence. Never launches Godot (docs/technical/91 § Test
    project separation).

    Shared deterministic fixture utilities and the first sample tests are owned
    by TASK-FND-003-001; this file only establishes the project and its pinned
    harness.
  -->

  <ItemGroup>
    <ProjectReference Include="../../src/MechaMiner.Persistence/MechaMiner.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
  </ItemGroup>

  <ItemGroup Label="Shared deterministic fixture utilities (TASK-FND-003-001)">
    <!--
      Linked, not referenced. doc 100 § Repository structure prescribes exactly four
      test projects and no shared test library, so the utilities are compiled into
      each test assembly and stay internal. See tests/shared/README.md.
    -->
    <Compile Include="../shared/**/*.cs" LinkBase="Support/Shared" />
  </ItemGroup>

</Project>
